# Copy to google-ads.yaml, or just run `uv run python -m shared.google_ads login`, which creates
# google-ads.yaml from your client_secret*.json and fills in the refresh token.

client_id: INSERT_CLIENT_ID.apps.googleusercontent.com
client_secret: INSERT_CLIENT_SECRET
refresh_token: INSERT_REFRESH_TOKEN

# 10-digit ID of the account you log in through, no dashes. If you access the
# Ads account via a manager account, this is the MANAGER account ID.
login_customer_id: "INSERT_LOGIN_CUSTOMER_ID"

# Only needed if you have a classic developer token from the Ads UI
# (Tools > API Center). Leave commented out when API access was granted to the
# Cloud project through the Google Ads API page in the Cloud Console.
# developer_token: INSERT_DEVELOPER_TOKEN

use_proto_plus: true

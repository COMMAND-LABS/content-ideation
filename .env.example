# Copy to .env and fill in. Both tools read this file; it is gitignored.

# YouTube Data API v3 key (repeatability-analysis/READMEs/youtube_api.md)
YOUTUBE_API_KEY=

# The LLM that groups phrasings into topics. With LLM_PROVIDER = "anthropic" in config.py, set ANTHROPIC_API_KEY instead.
OPENAI_API_KEY=

# Optional: the Ads account that keyword requests run against (10 digits, no dashes).
# Defaults to login_customer_id from keyword-analysis/google-ads.yaml when unset.
GOOGLE_ADS_CUSTOMER_ID=
